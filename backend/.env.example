# Sao chép thành .env và sửa user/mật khẩu MySQL của bạn
# Tạo database trước: CREATE DATABASE entdash CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/entdash"

# Bắt buộc đổi khi deploy production
JWT_SECRET="your-secret-key-here"

# Mã hóa mật khẩu account affiliate (để trống = dùng JWT_SECRET)
# AFFILIATE_CREDENTIAL_KEY=""

# Telegram bot (tùy chọn)
TELEGRAM_BOT_TOKEN=""
# URL công khai backend — Telegram gọi webhook khi admin bấm Duyệt/Hủy (không poll nền)
# Local dev: dùng ngrok → https://xxxx.ngrok-free.app/api/telegram/webhook
# Hoặc chỉ cần APP_URL, hệ thống tự ghép /api/telegram/webhook
APP_URL="https://your-domain.com"
# TELEGRAM_WEBHOOK_URL="https://your-domain.com/api/telegram/webhook"
# TELEGRAM_WEBHOOK_SECRET=""

# Chấm công — WiFi công ty: thêm trong bảng CompanyWifi (xem prisma/seed-attendance-wifi.sql)
# Dev: bỏ qua kiểm tra SSID (chỉ dùng local)
# ATTENDANCE_DEV_BYPASS=true
# ATTENDANCE_LATE_HOUR=9
# ATTENDANCE_LATE_MINUTE=0
# ATTENDANCE_WORK_END_HOUR=18
# ATTENDANCE_WORK_END_MINUTE=0
