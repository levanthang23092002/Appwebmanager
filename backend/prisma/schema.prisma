generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// PENDING = Đang chờ duyệt | APPROVED = Đã duyệt | LOCKED = Đã khóa
model User {
  id              Int           @id @default(autoincrement())
  name            String
  email           String        @unique
  password        String
  role            String        @default("staff")
  status          String        @default("PENDING")
  telegram        String?
  salary          Float         @default(0)
  avatar          String?   @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tasksAssigned   Task[]        @relation("AssignedTasks")
  tasksCreated    Task[]        @relation("CreatedTasks")
  affiliates      AffiliateTx[] @relation("ManagedAffiliates")
  costs           Cost[]        @relation("CostCreator")
  approvedCosts   Cost[]        @relation("CostApprover")
  canceledCosts   Cost[]        @relation("CostCanceller")
  telegramLinks   TelegramLinkPending[]
  attendances     Attendance[]

  @@index([status])
}

/** SSID WiFi công ty được phép chấm công */
model CompanyWifi {
  id        Int      @id @default(autoincrement())
  ssid      String   @unique @db.VarChar(120)
  label     String?  @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Attendance {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  checkInSsid  String?   @db.VarChar(120)
  checkOutSsid String?   @db.VarChar(120)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

/** Mã tạm khi user bấm Start trên bot — gắn chat_id vào User.telegram */
model TelegramLinkPending {
  token     String   @id @db.VarChar(32)
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Task {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?   @db.Text
  status       String    @default("PENDING_ACCEPTANCE")
  priority     String
  deadline     DateTime?
  rejectReason String?   @db.Text
  assigneeId   Int?
  assignee     User?     @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignerId   Int?
  assigner     User?     @relation("CreatedTasks", fields: [assignerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assigneeId])
  @@index([assignerId])
  @@index([status])
}

model AffiliateTx {
  id         Int      @id @default(autoincrement())
  source     String
  amount     Float
  status     String
  date       DateTime @default(now())
  assigneeId Int?
  assignee   User?    @relation("ManagedAffiliates", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
  @@index([assigneeId])
}

model Cost {
  id          Int       @id @default(autoincrement())
  type        String
  amount      Float
  description String?   @db.Text
  approved    Boolean   @default(false)
  approvedAt  DateTime?
  canceled    Boolean   @default(false)
  canceledAt  DateTime?
  userId      Int?
  creator     User?     @relation("CostCreator", fields: [userId], references: [id], onDelete: SetNull)
  approverId  Int?
  user        User?     @relation("CostApprover", fields: [approverId], references: [id], onDelete: SetNull)
  cancellerId Int?
  canceller   User?     @relation("CostCanceller", fields: [cancellerId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([approved])
  @@index([canceled])
  @@index([userId])
  @@index([approverId])
  @@index([cancellerId])
}
