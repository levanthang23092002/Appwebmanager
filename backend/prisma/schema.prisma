generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// PENDING = Đang chờ duyệt | APPROVED = Đã duyệt | LOCKED = Đã khóa
model User {
  id              Int           @id @default(autoincrement())
  name            String
  email           String        @unique
  password        String
  role            String        @default("staff")
  status          String        @default("PENDING")
  telegram        String?
  salary          Float         @default(0)
  avatar          String?   @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tasksAssigned   Task[]        @relation("AssignedTasks")
  tasksCreated    Task[]        @relation("CreatedTasks")
  affiliateAccounts AffiliateAccount[] @relation("AffiliateAccountOwner")
  affiliateRevenues AffiliateRevenue[] @relation("AffiliateRevenueCreator")
  costs           Cost[]        @relation("CostCreator")
  approvedCosts   Cost[]        @relation("CostApprover")
  canceledCosts   Cost[]        @relation("CostCanceller")
  telegramLinks   TelegramLinkPending[]
  attendances     Attendance[]
  dailyReports    DailyReport[]

  @@index([status])
}

/** Cấu hình hệ thống — tỉ giá, logo, tên app (admin, id = 1) */
model FinanceSettings {
  id         Int      @id @default(1)
  usdVndRate Float    @default(27000)
  logo       String?  @db.Text
  appName    String   @default("Eagle Rise")
  updatedAt  DateTime @updatedAt
}

/** Giờ làm việc chấm công (một bản ghi duy nhất, id = 1) */
model AttendanceSettings {
  id              Int      @id @default(1)
  workStartHour   Int      @default(9)
  workStartMinute Int      @default(0)
  workEndHour     Int      @default(18)
  workEndMinute   Int      @default(0)
  updatedAt       DateTime @updatedAt
}

/** SSID WiFi công ty được phép chấm công */
model CompanyWifi {
  id        Int      @id @default(autoincrement())
  ssid      String   @unique @db.VarChar(120)
  label     String?  @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Attendance {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  checkInSsid  String?   @db.VarChar(120)
  checkOutSsid String?   @db.VarChar(120)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

/** Báo cáo công việc cuối ngày — một bản ghi / user / ngày */
model DailyReport {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  content     String    @db.Text
  planNext    String?   @db.Text
  blockers    String?   @db.Text
  status      String    @default("DRAFT")
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([status])
  @@index([userId])
}

/** Mã tạm khi user bấm Start trên bot — gắn chat_id vào User.telegram */
model TelegramLinkPending {
  token     String   @id @db.VarChar(32)
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Task {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?   @db.Text
  status       String    @default("PENDING_ACCEPTANCE")
  priority     String
  deadline     DateTime?
  rejectReason String?   @db.Text
  assigneeId   Int?
  assignee     User?     @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignerId   Int?
  assigner     User?     @relation("CreatedTasks", fields: [assignerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assigneeId])
  @@index([assignerId])
  @@index([status])
  @@index([updatedAt])
}

/** Network affiliate — admin quản lý (Impact, Shopify Collab, ...) */
model AffiliateNetwork {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  logo      String?  @db.Text
  active    Boolean  @default(true)
  syncType  String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts  AffiliateAccount[]
  revenues  AffiliateRevenue[]

  @@index([active])
}

/** Tài khoản đăng nhập trên network — nhân viên/quản lý sở hữu */
model AffiliateAccount {
  id           Int              @id @default(autoincrement())
  networkId    Int
  network      AffiliateNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)
  ownerId      Int
  owner        User             @relation("AffiliateAccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  loginEmail   String
  passwordEnc  String           @db.Text
  note         String?          @db.Text
  dashboardUrl String?          @db.Text
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  stores       AffiliateStore[]
  revenues     AffiliateRevenue[]

  @@unique([networkId, loginEmail])
  @@index([ownerId])
  @@index([networkId])
  @@index([active])
}

/** Website/cửa hàng — tạo lazy khi nhập doanh thu hoặc sync API */
model AffiliateStore {
  id          Int              @id @default(autoincrement())
  accountId   Int
  account     AffiliateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String?
  domain      String
  externalRef String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  revenues    AffiliateRevenue[]

  @@unique([accountId, domain])
  @@index([accountId])
}

/** Bản ghi doanh thu — nhập tay hoặc API tự động */
model AffiliateRevenue {
  id              Int              @id @default(autoincrement())
  networkId       Int
  network         AffiliateNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)
  accountId       Int
  account         AffiliateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  storeId         Int?
  store           AffiliateStore?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeDomain     String?
  amount          Float
  orderCount      Int?
  currency        String           @default("USD")
  usdVndRate      Float            @default(27000)
  revenueDate     DateTime         @db.Date
  source          String           @default("MANUAL")
  status          String           @default("APPROVED")
  note            String?          @db.Text
  externalOrderId String?
  createdById     Int
  createdBy       User             @relation("AffiliateRevenueCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([revenueDate])
  @@index([accountId])
  @@index([networkId])
  @@index([createdById])
  @@index([source])
}

model Cost {
  id          Int       @id @default(autoincrement())
  type        String
  amount      Float
  currency    String    @default("VND")
  usdVndRate  Float     @default(27000)
  description String?   @db.Text
  approved    Boolean   @default(false)
  approvedAt  DateTime?
  canceled    Boolean   @default(false)
  canceledAt  DateTime?
  userId      Int?
  creator     User?     @relation("CostCreator", fields: [userId], references: [id], onDelete: SetNull)
  approverId  Int?
  user        User?     @relation("CostApprover", fields: [approverId], references: [id], onDelete: SetNull)
  cancellerId Int?
  canceller   User?     @relation("CostCanceller", fields: [cancellerId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([approved])
  @@index([canceled])
  @@index([userId])
  @@index([approverId])
  @@index([cancellerId])
  @@index([createdAt])
}
